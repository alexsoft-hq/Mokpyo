# =============================================================================
# Mokpyo 환경변수 예시 — 이 파일을 .env 로 복사해 값을 채운다.
#   cp .env.example .env
# 실제 값(비밀번호·시크릿·API 키)은 git 에 올리지 않는다. .env 는 gitignore 대상.
# 서버 및 프론트엔드 설정. 선택 항목은 사용하는 기능에 맞춰 입력한다.
# =============================================================================

# --- 필수: 데이터베이스 -------------------------------------------------------
# PostgreSQL. schema=dashboard 를 반드시 붙인다(모든 테이블이 dashboard 스키마에 있음).
# 아래 POSTGRES_* 값은 compose.yaml의 로컬 DB 초기화에도 사용한다.
#   운영:   postgresql://<user>:<pw>@db.example.com:5432/mokpyo?schema=dashboard
#   로컬:   postgresql://mokpyo:<pw>@localhost:5432/mokpyo_dev?schema=dashboard
POSTGRES_USER=mokpyo
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=mokpyo_dev
POSTGRES_PORT=5432
DATABASE_URL="postgresql://mokpyo:change-this-local-password@localhost:5432/mokpyo_dev?schema=dashboard"

# --- 필수: 시크릿 -------------------------------------------------------------
# 운영에서는 비어 있거나 기본값인 시크릿을 거부한다(server/lib/env.ts).
# 각 시크릿은 openssl rand -hex 32 등으로 생성한 서로 다른 값으로 채운다.
JWT_SECRET=
SESSION_SECRET=

# --- 서버 --------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# 초대·알림 메일에 들어가는 링크의 기준 주소(server/routes/invitations.ts:27).
# 미설정 시 http://localhost:5173 으로 폴백하므로, 로컬에서도 Vite 포트에 맞춘다.
APP_URL=http://localhost:8080
# Docker 전체 스택은 http://localhost:3001, 외부 운영은 실제 HTTPS 주소로 변경한다.

# --- 프론트엔드 빌드 ---------------------------------------------------------
# 서브디렉터리 배포 경로. 기본은 /, npm run build 는 /dashboard/ 용이다.
VITE_BASE_URL=/
# API 절대주소. 비워 두면 같은 오리진의 상대경로를 쓴다(src/lib/api/http.ts:8).
VITE_API_URL=

# --- 메일(SMTP) — 회원가입 인증·초대 발송 ------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
# true 로 두면 이메일 인증 절차를 건너뛴다(server/routes/auth.ts:52). 개발용.
SKIP_EMAIL_VERIFICATION=false

# --- Google OAuth 로그인 (선택) ----------------------------------------------
# 세 값이 모두 있을 때만 전략이 등록된다(server/auth/passport.ts:8).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://your-domain:3001/api/auth/google/callback

# --- 첨부파일 저장소 ---------------------------------------------------------
# local(기본) 이면 프로젝트 루트 uploads/ 에 저장, s3 이면 아래 두 값이 필수
# (server/utils/storage.ts:137).
STORAGE_TYPE=local
# AWS_S3_BUCKET=
# AWS_REGION=

# --- AI 리포트 (Azure OpenAI) ------------------------------------------------
# 네 값이 모두 있을 때만 AI 기능이 켜진다(server/utils/aiService.ts:31).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=

# --- 자동화 엔진 -------------------------------------------------------------
# false 로 두면 자동화 규칙 실행이 전면 정지한다(server/services/automation/engine.ts:12).
AUTOMATIONS_ENABLED=true

# --- 화면 표기 ---------------------------------------------------------------
DASHBOARD_TITLE=Mokpyo
DASHBOARD_SUBTITLE=조직명

# --- 보안·운영(선택) ---------------------------------------------------------
# 허용할 브라우저 오리진(쉼표 구분). 비우면 개발=전체 허용, 운영=동일 오리진만.
CORS_ORIGINS=
# nginx 등 프록시 뒤에서 실제 클라이언트 IP 기준으로 rate limit 을 걸 때 1.
TRUST_PROXY=
# 요청 제한: 일반 API(분당, 기본 600) / 인증 API(15분당, 기본 30)
RATE_LIMIT_PER_MIN=
AUTH_RATE_LIMIT_PER_15MIN=
# 첨부파일 저장 경로(기본 <cwd>/uploads)
UPLOADS_DIR=
# 로컬 HTTP Docker 체험에서만 false. 외부 운영은 HTTPS와 secure 쿠키를 사용한다.
COOKIE_SECURE=
